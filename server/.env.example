# Postgres connection string from your Neon or Supabase free-tier project
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Optional, independently per chain. RPC endpoint used for the Chainalysis
# on-chain sanctions oracle (isSanctioned() read call, no wallet/gas needed)
# on that chain. Leave any of these unset to run that chain in loud stub mode
# (screening results are tagged STUB). Free public RPCs work out of the box
# with no signup:
RPC_URL=https://ethereum.publicnode.com
RPC_URL_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_URL_BSC=https://bsc-dataseed.binance.org
# For more reliability, swap any of these for a free-tier Alchemy or Infura
# HTTPS URL for that chain — no code changes needed either way.

PORT=4000
